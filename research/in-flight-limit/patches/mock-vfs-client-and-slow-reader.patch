diff -ruN '--exclude=target' bench/mock-vfs/src/bin/slow-reader.rs wt-main/mock-vfs/src/bin/slow-reader.rs
--- bench/mock-vfs/src/bin/slow-reader.rs	1970-01-01 00:00:00.000000000 +0000
+++ wt-main/mock-vfs/src/bin/slow-reader.rs	2026-10-31 11:17:09.789737908 +0000
@@ -0,0 +1,96 @@
+//! A misbehaving client for back-pressure experiments: it pipelines requests as fast
+//! as the server accepts them and never reads a single reply.
+//!
+//! ```text
+//! slow-reader --target 127.0.0.1:2049 --op getattr|null|read --block 1M --duration 20s
+//! ```
+//!
+//! Prints, once per second, how many requests the server has accepted so far (bytes
+//! that `write` managed to push into the socket).
+
+use std::net::SocketAddr;
+use std::time::{Duration, Instant};
+
+use tokio::io::AsyncWriteExt;
+use tokio::net::TcpStream;
+
+use mock_vfs::cli::{self, Args};
+use mock_vfs::client::{self, mount, nfs, Connection};
+use nfs_mamont::consts::nfsv3::{NfsProc, NFS_PROGRAM, NFS_VERSION};
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() {
+    let mut args = Args::from_env();
+    let mut target: SocketAddr = "127.0.0.1:2049".parse().unwrap();
+    let mut op = "getattr".to_string();
+    let mut block: u64 = 1 << 20;
+    let mut duration = Duration::from_secs(20);
+    let mut connections: usize = 1;
+    while let Some(flag) = args.next_flag() {
+        match flag.as_str() {
+            "--target" => target = args.parse(&flag).unwrap(),
+            "--op" => op = args.value(&flag).unwrap(),
+            "--block" => block = args.parse_with(&flag, cli::parse_size).unwrap(),
+            "--duration" => duration = args.parse_with(&flag, cli::parse_duration).unwrap(),
+            "--connections" => connections = args.parse(&flag).unwrap(),
+            other => panic!("unknown flag {other}"),
+        }
+    }
+
+    let mut conn = Connection::connect(target).await.expect("connect");
+    let root = mount::mount(&mut conn, "/").await.expect("MNT");
+    let file = nfs::lookup(&mut conn, &root, "file_0").await.expect("LOOKUP").handle;
+
+    let (procedure, payload) = match op.as_str() {
+        "null" => (NfsProc::Null as u32, Vec::new()),
+        "getattr" => (NfsProc::GetAttr as u32, nfs::args::getattr(&file)),
+        "read" => (NfsProc::Read as u32, nfs::args::read(&file, 0, block as u32)),
+        other => panic!("unknown op {other}"),
+    };
+    let record = client::call_record(NFS_PROGRAM, NFS_VERSION, procedure, 1, &payload);
+    // 256 requests per write
+    let batch: Vec<u8> = (0..256).flat_map(|_| record.iter().copied()).collect();
+
+    let start = Instant::now();
+    let mut tasks = Vec::new();
+    for _ in 0..connections {
+        let batch = batch.clone();
+        let record_len = record.len() as u64;
+        tasks.push(tokio::spawn(async move {
+            let stream = TcpStream::connect(target).await.expect("connect");
+            let _ = stream.set_nodelay(true);
+            // keep the read half open but never read from it
+            let (_reader, mut writer) = stream.into_split();
+            let mut sent: u64 = 0;
+            let mut pos = 0usize;
+            let mut next_report = Duration::from_secs(1);
+            while start.elapsed() < duration {
+                // `write` is cancel-safe, `write_all` is not: a timed-out partial
+                // write must not break the record stream.
+                let write = writer.write(&batch[pos..]);
+                match tokio::time::timeout(Duration::from_millis(200), write).await {
+                    Ok(Ok(n)) => {
+                        sent += n as u64;
+                        pos = (pos + n) % batch.len();
+                    }
+                    Ok(Err(err)) => {
+                        eprintln!("write error: {err}");
+                        break;
+                    }
+                    Err(_) => {} // the server stopped reading: back-pressure
+                }
+                if start.elapsed() >= next_report {
+                    let accepted = sent / record_len;
+                    println!("t={:>4.1}s accepted_requests={accepted}", start.elapsed().as_secs_f64());
+                    next_report += Duration::from_secs(1);
+                }
+            }
+            sent / record_len
+        }));
+    }
+    let mut total = 0;
+    for t in tasks {
+        total += t.await.unwrap();
+    }
+    println!("total_accepted_requests={total}");
+}
